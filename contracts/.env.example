# HelpHive Smart Contracts Environment Variables
# Copy this file to .env and fill in your actual values

# Deployment Private Key (should have ETH for gas fees)
PRIVATE_KEY=your_deployment_private_key_here

# API Keys for different networks
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Polygon API Keys (for Polygon deployment)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Network RPC URLs
MAINNET_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/${ALCHEMY_API_KEY}
GOERLI_RPC_URL=https://eth-goerli.alchemyapi.io/v2/${ALCHEMY_API_KEY}
SEPOLIA_RPC_URL=https://eth-sepolia.alchemyapi.io/v2/${ALCHEMY_API_KEY}
POLYGON_RPC_URL=https://polygon-mainnet.alchemyapi.io/v2/${ALCHEMY_API_KEY}
MUMBAI_RPC_URL=https://polygon-mumbai.alchemyapi.io/v2/${ALCHEMY_API_KEY}

# Contract Configuration
INITIAL_FEE_RECIPIENT=0x...  # Address that will receive platform fees
INITIAL_FEE_PERCENTAGE=300   # 3% in basis points (300/10000 = 0.03)

# Gas Configuration
GAS_PRICE=20  # in gwei
GAS_LIMIT=3000000
